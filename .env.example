# Copy to .env.local and fill in. See https://app.flutterwave.com → Settings.

# Flutterwave public key (FLWPUBK-...). Safe to expose to the browser.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Flutterwave secret key (FLWSECK-...). Server only — used to verify transactions.
# NEVER prefix this with NEXT_PUBLIC_.
FLW_SECRET_KEY=

# Webhook "secret hash" — set the SAME value in the Flutterwave dashboard
# (Settings → Webhooks → Secret Hash) and here. Validates the `verif-hash`
# header on /api/webhooks/flutterwave — the only thing that grants VIP access.
FLUTTERWAVE_SECRET_HASH=

# --- Supabase (VIP membership + NextAuth session storage) ------------------
# Project Settings → API. Use the *service role* key — server only, bypasses
# Row Level Security. NEVER prefix this with NEXT_PUBLIC_ or expose it to the
# browser. Run supabase/schema.sql against this project once before use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- NextAuth (Auth.js v5) — email magic-link sign-in -----------------------
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 33
AUTH_SECRET=

# Resend (https://resend.com) — sends the magic-link email. Create an API key
# under API Keys, and verify a sending domain (or use their onboarding domain
# for testing) before setting EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM="2Odds Football Prediction <no-reply@2oddsfootballprediction.com>"

# --- OpenArt AI (scripts/generate-images.js only, not read by the app) -----
# Only needed to regenerate the hero/blog feature images. Get a key from
# your OpenArt account settings and confirm the endpoint shape in
# scripts/generate-images.js against OpenArt's current API docs first.
OPENART_API_KEY=

# --- Monetag ad zones -------------------------------------------------------
# Paste the exact script URL from Monetag → Sites → Zones for each format.
# Leave blank to disable that format. `*_ZONE` is only needed when the snippet
# also carries a data-zone id.
NEXT_PUBLIC_MONETAG_INPAGE_SRC=
NEXT_PUBLIC_MONETAG_INPAGE_ZONE=
NEXT_PUBLIC_MONETAG_ONCLICK_SRC=
NEXT_PUBLIC_MONETAG_ONCLICK_ZONE=
NEXT_PUBLIC_MONETAG_BANNER_SRC=
NEXT_PUBLIC_MONETAG_BANNER_ZONE=
